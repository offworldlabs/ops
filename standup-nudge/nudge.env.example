# Copy to a location outside this repository (the host uses
# /root/standup/nudge.env) and fill in your own values, then either keep it at
# the default path or point the script at it with STANDUP_CONFIG.
#
# Nothing in this file is a credential — the API token lives in its own file,
# referenced by CLICKUP_TOKEN_FILE below.
#
# An environment variable of the same name overrides anything set here, which
# keeps the script testable:  STANDUP_HOUR=23 DRY_RUN=1 ./nudge.sh

# ClickUp workspace and chat channel to post into. Both appear in the channel
# URL: https://app.clickup.com/<workspace_id>/v/cn/<channel_id>
CLICKUP_WORKSPACE_ID="000000000"
CLICKUP_CHANNEL_ID="0-000000000-0"

STANDUP_MESSAGE="What's everyone working on today? How did yesterday go?"

# Local hour, in STANDUP_TZ, at which the nudge should actually post. The
# schedule fires at every UTC hour this could land on; the guard drops the rest.
STANDUP_TZ="Europe/London"
STANDUP_HOUR="09"

# Path to a file containing only the ClickUp API token (mode 600). Generate one
# in ClickUp under Settings -> Apps -> API Token; it starts with "pk_".
CLICKUP_TOKEN_FILE="/root/standup/.clickup_token"

STANDUP_LOG="/root/standup/log.jsonl"
