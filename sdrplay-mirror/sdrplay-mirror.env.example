# Copy to a location outside this repository (the host uses
# /root/sdrplay-mirror/sdrplay-mirror.env) and fill in your own values, then
# either keep it at the default path or point the script at it with
# SDRPLAY_MIRROR_CONFIG.
#
# Nothing in this file is a credential - the R2 access key and secret live in
# their own file, referenced by R2_CREDENTIALS_FILE below.
#
# An environment variable of the same name overrides anything set here, which
# keeps the script testable: DRY_RUN=1 ./sdrplay-mirror.sh ...

# R2's S3-compatible API endpoint for this account, and the bucket name.
# Found in the Cloudflare dashboard under R2 -> the bucket -> Settings.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_BUCKET="sdrplay-api-mirror"

# Path to a file containing R2 API token credentials (mode 600), e.g.:
#   AWS_ACCESS_KEY_ID="..."
#   AWS_SECRET_ACCESS_KEY="..."
# Generate one in the Cloudflare dashboard under R2 -> Manage API Tokens ->
# Create API Token, scoped to Object Read & Write on this bucket only.
R2_CREDENTIALS_FILE="/root/sdrplay-mirror/.r2_credentials"

SDRPLAY_MIRROR_LOG="/root/sdrplay-mirror/log.jsonl"
